# Copy this to .env and adjust if needed.
#
# IMPORTANT: use the same hostname family (localhost vs 127.0.0.1) here as
# whatever hostname you open THIS frontend with in the browser. The refresh
# token cookie is SameSite=Lax, and browsers treat "localhost" and
# "127.0.0.1" as different SITES even though both point at your machine —
# a mismatch here silently breaks the httpOnly-cookie refresh flow (login
# works, but a page reload logs you out instead of restoring the session).
VITE_API_BASE_URL=http://localhost:8000/api
